rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Define que qualquer documento dentro da coleção 'users' de um usuário específico
    // só pode ser acessado por aquele próprio usuário.
    // A variável {userId} corresponde ao ID do usuário autenticado.
    // A expressão {document=**} significa "qualquer documento ou subcoleção abaixo disso".
    match /users/{userId}/{document=**} {
      // Permite leitura (read) e escrita (write) se:
      // 1. O usuário está autenticado (request.auth != null)
      // 2. O ID do usuário autenticado (request.auth.uid) é o mesmo do
      //    documento que ele está tentando acessar ({userId}).
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
